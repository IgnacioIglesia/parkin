# Copiar a .env.local para cambiar algo; nunca commitear .env.local.

# Base de la API. Vacío = mismo origen (el proxy de Vite en desarrollo, el gateway en producción).
VITE_API_URL=

# true = la búsqueda usa datos de ejemplo hasta que el servicio de Cocheras esté listo.
VITE_MOCK_COCHERAS=true

# Solo desarrollo: a dónde manda el proxy de Vite.
# Si PROXY_GATEWAY tiene valor, todo (/api, /graphql, /ws) va al gateway.
PROXY_USUARIOS=http://localhost:3001
PROXY_GATEWAY=
