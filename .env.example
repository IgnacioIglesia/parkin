# Configuración por entorno (12-Factor III). Cada servicio lee solo sus variables.
# Copiar a .env en la carpeta del servicio; nunca commitear .env.

# Compartidas
RABBITMQ_URL=amqp://guest:guest@localhost:5672
REDIS_URL=redis://localhost:6379
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# usuarios
USUARIOS_DATABASE_URL=postgres://app:app@localhost:5441/usuarios
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem

# cocheras
COCHERAS_DATABASE_URL=postgres://app:app@localhost:5442/cocheras

# reservas
RESERVAS_DATABASE_URL=postgres://app:app@localhost:5443/reservas
RETENCION_MINUTOS=10

# pagos
PAGOS_DATABASE_URL=postgres://app:app@localhost:5444/pagos
PASARELA_ACCESS_TOKEN=
PASARELA_WEBHOOK_SECRET=
