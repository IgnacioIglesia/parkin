  ],
  "queues": [
    {
      "name": "reservas.pago-eventos", "vhost": "/", "durable": true, "auto_delete": false,
      "arguments": { "x-queue-type": "quorum", "x-delivery-limit": 3, "x-dead-letter-exchange": "cocheras.dlx" }
    },
    {
      "name": "pagos.reserva-eventos", "vhost": "/", "durable": true, "auto_delete": false,
      "arguments": { "x-queue-type": "quorum", "x-delivery-limit": 3, "x-dead-letter-exchange": "cocheras.dlx" }
    },
    {
