# Normaliza finales de línea en el repo (LF), sin importar el core.autocrlf de cada uno
* text=auto eol=lf

# Archivos que corren dentro de contenedores Linux: siempre LF
*.sh text eol=lf
Dockerfile text eol=lf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Registro de IA: todos agregan filas al final. Al mergear se conservan las líneas de ambos
# lados en vez de marcar conflicto (solo en merges locales; GitHub igual lo muestra en el PR).
docs/uso-ia.md merge=union
