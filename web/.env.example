# Copiar a .env.local para cambiar algo; nunca commitear .env.local.

# Base de la API. Vacío = mismo origen (el proxy de Vite en desarrollo, el gateway en producción).
VITE_API_URL=

# true = la búsqueda usa datos de ejemplo, para trabajar sin el backend levantado.
VITE_MOCK_COCHERAS=false

# Solo desarrollo: a dónde manda el proxy de Vite /api, /graphql y /ws.
PROXY_GATEWAY=http://localhost:8080
