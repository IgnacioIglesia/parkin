    },
    { "name": "cocheras.dlq", "vhost": "/", "durable": true, "auto_delete": false, "arguments": {} }
  ],
  "bindings": [
    { "source": "cocheras.eventos", "vhost": "/", "destination": "reservas.pago-eventos", "destination_type": "queue", "routing_key": "pago.aprobado", "arguments": {} },
    { "source": "cocheras.eventos", "vhost": "/", "destination": "reservas.pago-eventos", "destination_type": "queue", "routing_key": "pago.rechazado", "arguments": {} },

    { "source": "cocheras.eventos", "vhost": "/", "destination": "pagos.reserva-eventos", "destination_type": "queue", "routing_key": "reserva.creada", "arguments": {} },
    { "source": "cocheras.eventos", "vhost": "/", "destination": "pagos.reserva-eventos", "destination_type": "queue", "routing_key": "reserva.confirmada", "arguments": {} },
    { "source": "cocheras.eventos", "vhost": "/", "destination": "pagos.reserva-eventos", "destination_type": "queue", "routing_key": "reserva.cancelada", "arguments": {} },
    { "source": "cocheras.eventos", "vhost": "/", "destination": "pagos.reserva-eventos", "destination_type": "queue", "routing_key": "reserva.expirada", "arguments": {} },

    { "source": "cocheras.eventos", "vhost": "/", "destination": "cocheras.reserva-eventos", "destination_type": "queue", "routing_key": "reserva.confirmada", "arguments": {} },
    { "source": "cocheras.eventos", "vhost": "/", "destination": "cocheras.reserva-eventos", "destination_type": "queue", "routing_key": "reserva.cancelada", "arguments": {} },

    { "source": "cocheras.dlx", "vhost": "/", "destination": "cocheras.dlq", "destination_type": "queue", "routing_key": "", "arguments": {} }
