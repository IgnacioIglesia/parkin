# Configuración por entorno (12-Factor III). Copiar a .env; nunca commitear .env.

# Postgres
POSTGRES_USER=parkin
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Una base por servicio (database-per-service)
USUARIOS_DB=parkin_usuarios
COCHERAS_DB=parkin_cocheras
RESERVAS_DB=parkin_reservas
PAGOS_DB=parkin_pagos

# RabbitMQ
RABBITMQ_USER=parkin
RABBITMQ_PASSWORD=change-me
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Puertos de los servicios
USUARIOS_PORT=8081
COCHERAS_PORT=8082
RESERVAS_PORT=8083
PAGOS_PORT=8084

# Auth
JWT_SECRET=change-me
